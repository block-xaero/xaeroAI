{
    "adapter_path": "adapters/design-analyst-v4",
    "batch_size": 4,
    "config": "scripts/lora_config.yaml",
    "data": "data/mlx_final",
    "fine_tune_type": "lora",
    "grad_accumulation_steps": 1,
    "grad_checkpoint": false,
    "iters": 600,
    "learning_rate": 1e-05,
    "lora_parameters": {
        "keys": [
            "self_attn.q_proj",
            "self_attn.k_proj",
            "self_attn.v_proj",
            "self_attn.o_proj"
        ],
        "rank": 8,
        "alpha": 16,
        "scale": 20.0,
        "dropout": 0.1
    },
    "lr_schedule": {
        "name": "cosine_decay",
        "warmup": 50,
        "warmup_init": 1e-07,
        "arguments": [
            1e-05,
            600,
            1e-07
        ]
    },
    "mask_prompt": false,
    "max_seq_length": 2048,
    "model": "microsoft/Phi-3-mini-4k-instruct",
    "num_layers": 16,
    "optimizer": "adam",
    "optimizer_config": {
        "adam": {},
        "adamw": {},
        "muon": {},
        "sgd": {},
        "adafactor": {}
    },
    "project_name": null,
    "report_to": null,
    "resume_adapter_file": null,
    "save_every": 100,
    "seed": 0,
    "steps_per_eval": 100,
    "steps_per_report": 10,
    "test": true,
    "test_batches": 50,
    "train": true,
    "val_batches": 25
}